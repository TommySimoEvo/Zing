<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Zing</AssemblyName>
    <Product>Zing</Product>
    <Version>0.5.0</Version>
    <ApplicationIcon>zing.ico</ApplicationIcon>
    <SatelliteResourceLanguages>it;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.6.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="assets\**" LogicalName="assets/%(Filename)%(Extension)" />
    <InternalsVisibleTo Include="Zing.Tests" />
  </ItemGroup>

</Project>
