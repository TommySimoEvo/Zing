<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputName>Zing-$(Version)-x64</OutputName>
    <Platform>x64</Platform>
    <InstallerPlatform>x64</InstallerPlatform>
    <DefineConstants>Version=$(Version);PublishDir=$(PublishDir)</DefineConstants>
    <!-- Installazione per utente in %LOCALAPPDATA%: i controlli ICE pensati per Program Files non si applicano -->
    <SuppressIces>ICE38;ICE64;ICE91</SuppressIces>
  </PropertyGroup>
</Project>
